NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional product analytics (PostHog). Leave the key empty to turn analytics off entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Atlas Pro (docs/pro-subscription-setup.md). All optional: with none set, the paywall says "Pro is
# coming soon", checkout/webhooks answer 503, and nothing is limited.
# Turn on the free-tier limit (3 syllabus imports per term) only once web AND mobile purchases work.
PRO_ENFORCE_LIMITS=false
# Stripe (web checkout + customer portal). Server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# RevenueCat webhook (mobile purchases): the exact Authorization header value set in RevenueCat
# (a bare secret or "Bearer <secret>" both work). REVENUECAT_ENTITLEMENT_ID defaults to "pro".
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=pro
# Let SANDBOX (TestFlight / license tester) purchases grant Pro. Only on a staging/preview host.
REVENUECAT_ALLOW_SANDBOX=false
